# --- OpenAI (required) ---
# Powers voice calls, chat and the scorecard. Without it the app shows setup instructions.
OPENAI_API_KEY=
# Chat model for typed replies and the scorecard.
# OPENAI_MODEL=gpt-5.4-mini
# Chat completions endpoint. Point it at an OpenAI-compatible server (e.g. Ollama); voice calls always use OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Voice calls ---
# Speech-to-speech model. gpt-realtime-2.1 is sharper and costs more.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Transcribes your side of a call for the chat and the scorecard.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Two-letter language code for call transcription (e.g. en, de). Leave unset to auto-detect.
# TRANSCRIBE_LANGUAGE=
# A call ends after this many minutes, to bound its cost. The server hangs up through OpenAI's API and allows at
# most 2 calls at once. Both live in the server's memory: on serverless hosts a timer can't outlive the request,
# so there they're best effort. Set a spend limit on your OpenAI account as well.
# CALL_MAX_MINUTES=20

# --- Access ---
# Required, at least 12 characters. The owner signs in with this password; every page and API route needs it.
# Without it (or if it's shorter) nothing opens. Generate one with: openssl rand -base64 18
ADMIN_PASSWORD=
# Recommended. Random key, at least 32 characters, that signs session cookies: openssl rand -base64 32
# Without it the key is derived from ADMIN_PASSWORD (PBKDF2). Changing it or the password signs every session out.
# SESSION_SECRET=
# Requests per minute per client, per bucket (chat/feedback; starting calls has a lower limit, and sign-in
# counts failed attempts: 10 per client per 15 minutes, then a global backoff after 50 failures in an hour).
# RATE_LIMIT_PER_MINUTE=30
# Reverse proxies in front of the app whose X-Forwarded-For you trust. Defaults to 1 on Vercel, Render, Railway,
# Fly.io and Heroku, otherwise 0 (signed-in users get a limit per session, everyone else shares one).
# TRUSTED_PROXY_HOPS=

# --- Site ---
# Public URL of this deployment, used in Open Graph metadata. When it's https the session cookie is always Secure.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
